# Dynamic server wallet → Tempo (MPP) integration
# Copy to `.env` and fill in your Dynamic values. Keys already set in the process
# environment win; `.env` never overrides them.

# --- Step 1: DynamicEvmWalletClient ------------------------------------------
# Dynamic environment ID (Dashboard → Developers → Environments).
DYNAMIC_ENVIRONMENT_ID=

# Dynamic API token (Dashboard → Developers → API tokens).
DYNAMIC_API_TOKEN=

# Password that encrypts the client key share backup in Dynamic's client share
# service. Required when DYNAMIC_BACKUP_TO_CLIENT_SHARE_SERVICE is enabled.
DYNAMIC_WALLET_PASSWORD=

# Optional: point at a self-hosted or staging Dynamic deployment.
# DYNAMIC_BASE_API_URL=
# DYNAMIC_BASE_MPC_RELAY_API_URL=

# --- Step 2: wallet creation -------------------------------------------------
# Threshold signature scheme used by `createWalletAccount`.
# One of TWO_OF_TWO, TWO_OF_THREE, THREE_OF_FIVE.
DYNAMIC_THRESHOLD_SIGNATURE_SCHEME=TWO_OF_TWO

# Back the client key share up to Dynamic's client share service.
DYNAMIC_BACKUP_TO_CLIENT_SHARE_SERVICE=true

# Local file holding the wallet metadata. Key shares stay in Dynamic and are
# recovered on demand using DYNAMIC_WALLET_PASSWORD. Re-running with
# DYNAMIC_RESET_WALLET=true runs keygen again and replaces this record.
DYNAMIC_WALLET_STORE=.dynamic-wallet.json
DYNAMIC_RESET_WALLET=false

# --- Step 3: Tempo Moderato faucet -------------------------------------------
# RPC endpoint used for `tempo_fundAddress`, balances and chain reads.
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# Skip faucet funding (e.g. the wallet already holds test stablecoins).
TEMPO_SKIP_FAUCET=false

# --- Step 5: MPP payment -----------------------------------------------------
# 402-protected endpoint paid through `mppx.fetch`.
MPP_URL=https://mpp.dev/api/ping/paid

# Also replace `globalThis.fetch` with the payment-aware wrapper.
# mppx defaults this to true; this project defaults it to false so plain fetch
# calls (e.g. the faucet POST) are never intercepted.
MPP_POLYFILL_FETCH=false

# --- Offline / CI ------------------------------------------------------------
# Used by `node src/tempo/run.js --dry-run` to sign without the Dynamic MPC
# network. Any funded Moderato test key works.
# DYNAMIC_TEMPO_DRY_RUN_PRIVATE_KEY=

# =============================================================================
# Clerk (required on every route)
# =============================================================================
# `app/layout.tsx` mounts a ClerkProvider, `components/nav.tsx` renders the
# sign-in/up buttons, and `proxy.ts` runs `clerkMiddleware`. Without these the
# app still builds but every page renders a provider with no publishable key.
# Dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# =============================================================================
# Spigot app (pay-per-call agent runtime)
# =============================================================================
# The values above drive the CLI in `cli/tempo/`. The web app reads its own
# wallet and model config from these, and settles real TIP-20 transfers.

# --- Agent wallet ------------------------------------------------------------
# Which signer backs the agent's Tempo wallet: `privateKey` or `dynamic`.
TEMPO_SIGNER=privateKey

# Private key for the agent wallet, used when TEMPO_SIGNER=privateKey.
# Fund it on testnet with the Moderato faucet:
#   POST https://rpc.moderato.tempo.xyz
#   {"jsonrpc":"2.0","id":1,"method":"tempo_fundAddress","params":["<address>"]}
TEMPO_PRIVATE_KEY=

# Required before the app can settle. Use a valid wallet you control.
# Unset, invalid, zero, and known dead addresses are rejected.
TEMPO_MERCHANT_ADDRESS=

# Base URL the agent uses to call its own paid endpoints.
SPIGOT_SELF_URL=http://localhost:3000

# --- LLM ---------------------------------------------------------------------
# Which provider the LangGraph agent calls: `gateway`, `openai` or `gemini`.
# All three are reached through the same OpenAI-compatible client, so each one
# is just a base URL plus a key. Pick one and set the matching key below.
LLM_PROVIDER=gateway

# Used when LLM_PROVIDER=gateway (default provider).
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=https://api.llmgateway.dev/v1
LLM_GATEWAY_MODEL=anthropic/claude-3.5-sonnet

# Used when LLM_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # omit for the OpenAI default

# Used when LLM_PROVIDER=gemini. Google's OpenAI-compatibility layer, so the
# same key from Google AI Studio works with no code change.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Overrides the model for whichever provider is selected.
# LLM_MODEL=

# Overrides the base URL for whichever provider is selected. Use this to point
# at any other OpenAI-compatible host (OpenRouter, Groq, a local vLLM) without
# needing a named provider above.
# LLM_BASE_URL=
